{
  "entities": {
    "BusinessConfig": {
      "title": "BusinessConfig",
      "description": "Public business settings and invoice configuration",
      "type": "object",
      "properties": {
        "businessName": { "type": "string" },
        "name": { "type": "string" },
        "logoUrl": { "type": "string" },
        "whatsapp": { "type": "string" },
        "phone": { "type": "string" },
        "warrantyDays": { "type": "number" },
        "warranty": { "type": "string" },
        "thankYouMessage": { "type": "string" },
        "customTrackingUrl": { "type": "string" },
        "enableLiveInstagramTracking": { "type": "boolean" }
      }
    },
    "ProviderCredentialsConfig": {
      "title": "ProviderCredentialsConfig",
      "description": "Private SMM provider API credentials restricted to admin",
      "type": "object",
      "properties": {
        "providerApiUrl": { "type": "string" },
        "providerApiKey": { "type": "string" },
        "rapidApiKey": { "type": "string" },
        "updatedAt": { "type": "string" },
        "migratedAt": { "type": "string" }
      },
      "required": ["providerApiUrl", "providerApiKey"]
    },
    "SocialNetwork": {
      "title": "SocialNetwork",
      "description": "Social network entry",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "icon": { "type": "string" }
      }
    },
    "Service": {
      "title": "Service",
      "description": "Service offered by business",
      "type": "object",
      "properties": {
        "socialNetworkId": { "type": "string" },
        "name": { "type": "string" },
        "providerCostPer1000": { "type": "number" },
        "providerCostUSDPer1000": { "type": "number" },
        "suggestedPricePer1000": { "type": "number" }
      }
    },
    "ServiceCombo": {
      "title": "ServiceCombo",
      "description": "Promotional service combo bundle",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "socialNetworkId": { "type": "string" },
        "comboPrice": { "type": "number" },
        "active": { "type": "boolean" }
      }
    },
    "Receipt": {
      "title": "Receipt",
      "description": "Public receipt document issued to client (contains only customer-facing fields)",
      "type": "object",
      "properties": {
        "consecutive": { "type": "number" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "subtotal": { "type": "number" },
        "totalCharged": { "type": "number" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "warranty": { "type": "string" },
        "thankYouMessage": { "type": "string" },
        "targetAccount": { "type": "string" },
        "initialFollowers": { "type": "number" }
      }
    },
    "ReceiptPrivate": {
      "title": "ReceiptPrivate",
      "description": "Private internal receipt data restricted strictly to admin (costs, profit, margins, internal notes)",
      "type": "object",
      "properties": {
        "receiptId": { "type": "string" },
        "clientId": { "type": "string" },
        "internalNotes": { "type": "string" },
        "totalProviderCost": { "type": "number" },
        "totalProviderCostUSD": { "type": "number" },
        "totalProfit": { "type": "number" },
        "trmUsed": { "type": "number" },
        "trmDate": { "type": "string" },
        "servicesPrivate": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    },
    "Client": {
      "title": "Client",
      "description": "CRM Client record managed by admin",
      "type": "object",
      "properties": {
        "clientCode": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "purchaseCount": { "type": "number" },
        "totalSpent": { "type": "number" },
        "lastPurchaseDate": { "type": "string" }
      }
    },
    "SupplierWarrantyRecord": {
      "title": "SupplierWarrantyRecord",
      "description": "Warranty claim record sent to provider with date and deadline tracking",
      "type": "object",
      "properties": {
        "providerOrderId": { "type": "string" },
        "clientName": { "type": "string" },
        "serviceName": { "type": "string" },
        "sentDate": { "type": "string" },
        "expectedResponseHours": { "type": "number" },
        "status": { "type": "string" },
        "reason": { "type": "string" },
        "isReopenedFromCancelled": { "type": "boolean" },
        "originalReceiptConsecutive": { "type": "number" },
        "originalReceiptId": { "type": "string" },
        "previousProviderOrderId": { "type": "string" },
        "previousWarrantyId": { "type": "string" },
        "reopenReason": { "type": "string" },
        "reopenDate": { "type": "string" },
        "traceabilityNotes": { "type": "string" }
      }
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Web registered user profile",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "config/business": { "schema": "BusinessConfig", "description": "Public business configuration" },
    "config/provider": { "schema": "ProviderCredentialsConfig", "description": "Private provider API credentials (admin only)" },
    "social_networks/{id}": { "schema": "SocialNetwork", "description": "Social networks" },
    "services/{id}": { "schema": "Service", "description": "Services" },
    "combos/{id}": { "schema": "ServiceCombo", "description": "Service combos" },
    "receipts/{receiptId}": { "schema": "Receipt", "description": "Public receipts (customer-facing fields only)" },
    "receipts_private/{receiptId}": { "schema": "ReceiptPrivate", "description": "Private receipt internal notes, provider costs, and profits (admin only)" },
    "clients/{id}": { "schema": "Client", "description": "CRM Clients" },
    "supplier_warranties/{id}": { "schema": "SupplierWarrantyRecord", "description": "Supplier warranty claims tracking" },
    "users/{userId}": { "schema": "UserProfile", "description": "Registered web client profile" }
  }
}
