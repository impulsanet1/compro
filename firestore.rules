rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public customer order tracking: Allow read of a single receipt by direct ID (via QR/URL)
    // Listing, querying, and all write operations remain strictly restricted to authenticated users.
    match /receipts/{receiptId} {
      allow get: if true;
      allow list, create, update, delete: if request.auth != null;
    }

    // Allow public read of business info (name, whatsapp support) for customer tracking view
    match /config/business {
      allow get: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
